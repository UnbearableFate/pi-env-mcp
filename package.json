{
	"name": "pi-env-mcp",
	"version": "0.2.0",
	"description": "MCP server that gives Claude Code, Codex and other MCP agents persistent access to remote machines over SSH through the pi-env daemon",
	"type": "module",
	"bin": {
		"pi-env-mcp": "dist/cli.js"
	},
	"files": [
		"dist",
		"README.md"
	],
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"check": "tsc --noEmit -p tsconfig.json",
		"test": "vitest --run test/unit",
		"test:remote": "vitest --run test/remote",
		"prepare": "npm run build"
	},
	"keywords": [
		"mcp",
		"ssh",
		"remote",
		"pi-env",
		"claude-code",
		"codex"
	],
	"license": "MIT",
	"dependencies": {
		"@earendil-works/chord": "1.5.0",
		"@earendil-works/pi-durable": "1.5.0",
		"@earendil-works/pi-env": "file:vendor/earendil-works-pi-env-1.5.0-main.8a19e8c4a.tgz",
		"@earendil-works/pi-mcp": "file:vendor/earendil-works-pi-mcp-1.5.0-main.8a19e8c4a.tgz",
		"@modelcontextprotocol/sdk": "1.32.2",
		"@xterm/headless": "6.0.0",
		"picomatch": "4.0.7",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"@types/picomatch": "4.0.3",
		"typescript": "7.0.2",
		"vitest": "4.1.12"
	}
}
